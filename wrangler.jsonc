{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-ac-plc-rzky",
  "main": "index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "PLC", "class_name": "PlcCampus"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["PlcCampus"]}
  ],
  "observability": {"enabled": true}
}
